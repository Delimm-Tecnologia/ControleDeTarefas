# ============================================================
# Arquivo de variáveis de ambiente — renomeie para .env
# ============================================================

# URL base da sua API backend
# Exemplos:
#   Desenvolvimento local:  http://localhost:3000/api
#   Produção:               https://api.suaempresa.com/v1
VITE_API_URL=http://localhost:3000/api

# Gemini API Key (injetado automaticamente pelo AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL da aplicação (injetado automaticamente pelo AI Studio)
APP_URL="MY_APP_URL"
